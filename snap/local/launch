#!/bin/sh
# Lanceur du snap : envoie le son de l'appli (ALSA, via cpal) au serveur PulseAudio/PipeWire de
# la session. La configuration ALSA de l'hôte n'est pas utilisable dans le snap : elle désigne
# des modules installés hors du snap.
lib="$SNAP/usr/lib/x86_64-linux-gnu/alsa-lib"
conf="$SNAP_USER_DATA/asound.conf"
cat > "$conf" <<EOF
pcm.!default { type pulse }
ctl.!default { type pulse }
pcm_type.pulse { lib "$lib/libasound_module_pcm_pulse.so" }
ctl_type.pulse { lib "$lib/libasound_module_ctl_pulse.so" }
EOF
export ALSA_CONFIG_PATH="$conf"
# Le XDG_RUNTIME_DIR d'un snap est un sous-dossier de celui de la session : les sockets de la
# session (son, Wayland) sont un niveau au-dessus.
mkdir -p "$XDG_RUNTIME_DIR"
session_runtime="$(dirname "$XDG_RUNTIME_DIR")"
export PULSE_SERVER="${PULSE_SERVER:-unix:$session_runtime/pulse/native}"
# Wayland cherche un WAYLAND_DISPLAY relatif (« wayland-0 ») dans XDG_RUNTIME_DIR : on lui
# donne le chemin complet du socket de la session.
case "${WAYLAND_DISPLAY:-}" in
  "" | /*) ;;
  *) export WAYLAND_DISPLAY="$session_runtime/$WAYLAND_DISPLAY" ;;
esac
exec "$@"
